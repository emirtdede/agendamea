{
  "name": "agendamea",
  "private": true,
  "version": "1.1.0",
  "main": "electron/main.cjs",
  "bin": {
    "agendamea": "./cli/agendamea.cjs"
  },
  "description": "Günlük görevlerinizi zahmetsizce planlayın. İnternetsiz çalışan, her değişikliği anında kaydeden sade ve hızlı Windows görev yöneticisi.",
  "author": {
    "name": "Vellium",
    "email": "support@vellium.dev",
    "url": "https://vellium.dev"
  },
  "homepage": "https://vellium.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/emirtdede/agendamea.git"
  },
  "bugs": {
    "email": "support@vellium.dev",
    "url": "https://github.com/emirtdede/agendamea/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "node scripts/sync-voice-assets.mjs && tsx server.ts",
    "start": "node server.ts",
    "build:server": "node scripts/build-server.mjs",
    "build": "node scripts/sync-voice-assets.mjs && vite build && npm run build:server",
    "sync:voice-assets": "node scripts/sync-voice-assets.mjs",
    "preview": "vite preview",
    "electron:dev": "electron .",
    "electron:rebuild": "electron-builder install-app-deps",
    "dist:win": "npm run build && electron-builder --win portable --x64 --publish never && node scripts/build-modern-setup.mjs --rebuild-app",
    "dist:win:setup": "npm run build && node scripts/build-modern-setup.mjs --rebuild-app",
    "dist:win:appx": "npm run build && electron-builder --win appx --x64 --publish never",
    "dist:win:dir": "npm run build && electron-builder --win --x64 --dir --publish never",
    "test:setup": "npx tsx scripts/generate-installer-locales.mjs && dotnet run --project installer/Agendamea.Setup.Tests/Agendamea.Setup.Tests.csproj -c Release",
    "icons:generate": "node scripts/generate-icons.mjs",
    "icons:installer": "node scripts/generate-installer-assets.mjs",
    "test": "node scripts/sync-voice-assets.mjs && tsx --test src/utils/todoLogic.test.ts src/utils/aiVoice.test.ts",
    "clean": "node -e \"import('node:fs').then(fs=>{fs.rmSync('dist',{recursive:true,force:true});fs.rmSync('dist-server',{recursive:true,force:true});fs.rmSync('release',{recursive:true,force:true});fs.rmSync('server.js',{force:true});})\"",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@diffusionstudio/piper-wasm": "^1.0.0",
    "@fugood/whisper.node": "^1.2.0-rc.2",
    "@ricky0123/vad-web": "^0.0.31",
    "@sapphi-red/web-noise-suppressor": "^0.4.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@vitejs/plugin-react": "^6.1.1",
    "better-sqlite3": "^13.2.0",
    "electron-updater": "^6.8.11",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "node-llama-cpp": "^3.22.3",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite-plugin-pwa": "^2.0.0"
  }
}
