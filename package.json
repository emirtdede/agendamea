{
  "name": "agendamea",
  "private": true,
  "version": "1.0.0",
  "main": "electron/main.cjs",
  "bin": {
    "agendamea": "./cli/agendamea.cjs"
  },
  "description": "Günlük görevlerinizi zahmetsizce planlayın. İnternetsiz çalışan, her değişikliği anında kaydeden sade ve hızlı Windows görev yöneticisi.",
  "author": {
    "name": "Vellium",
    "email": "support@vellium.dev",
    "url": "https://vellium.dev"
  },
  "homepage": "https://vellium.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/emirtdede/agendamea.git"
  },
  "bugs": {
    "email": "support@vellium.dev",
    "url": "https://github.com/emirtdede/agendamea/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node server.ts",
    "build:server": "node scripts/build-server.mjs",
    "build": "vite build && npm run build:server",
    "preview": "vite preview",
    "electron:dev": "electron .",
    "electron:rebuild": "electron-builder install-app-deps",
    "dist:win": "npm run build && electron-builder --win nsis portable --x64",
    "dist:win:appx": "npm run build && electron-builder --win appx --x64",
    "dist:win:dir": "npm run build && electron-builder --win --x64 --dir",
    "icons:generate": "node scripts/generate-icons.mjs",
    "icons:installer": "node scripts/generate-installer-assets.mjs",
    "test": "tsx --test src/utils/todoLogic.test.ts",
    "clean": "node -e \"import('node:fs').then(fs=>{fs.rmSync('dist',{recursive:true,force:true});fs.rmSync('dist-server',{recursive:true,force:true});fs.rmSync('release',{recursive:true,force:true});fs.rmSync('server.js',{force:true});})\"",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@vitejs/plugin-react": "^6.1.1",
    "better-sqlite3": "^13.2.0",
    "electron-updater": "^6.8.11",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite-plugin-pwa": "^2.0.0"
  }
}
